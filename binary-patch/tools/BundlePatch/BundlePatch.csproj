<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BundlePatch</AssemblyName>
    <RootNamespace>BundlePatch</RootNamespace>
  </PropertyGroup>
  <!-- Microsoft.NET.HostModel.dll ships inside the .NET SDK (used by the single-file bundler). -->
  <ItemGroup>
    <Reference Include="Microsoft.NET.HostModel">
      <HintPath>$(MSBuildSDKsPath)\..\Microsoft.NET.HostModel.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
